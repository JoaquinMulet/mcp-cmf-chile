{
  "name": "mcp-cmf-chile",
  "version": "0.1.0",
  "description": "MCP server para la Comisión para el Mercado Financiero de Chile (CMF): empresas en bolsa, EEFF, fondos mutuos, fondos de inversión, normativa, seguros, indicadores y bancos. Libre, gratuito y open-source.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mcp-cmf-chile": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "wrangler dev",
    "dev": "node --watch dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "verify": "tsx test/verify-endpoints.ts",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "ci-remoto": "node herramientas/ci-remoto.mjs",
    "predeploy": "node herramientas/ci-remoto.mjs",
    "deploy": "wrangler deploy",
    "ci": "npm run build && npm test && npx tsx test/verify-endpoints.ts",
    "verificar-desplegado": "npx tsx test/verify-proto.ts && npx tsx test/verify-remote.ts",
    "preparar-hooks": "git config core.hooksPath .githooks",
    "limpieza": "node herramientas/oportunidades.mjs",
    "trinquete": "node herramientas/trinquete.mjs",
    "lint": "biome lint src test",
    "alertas": "node herramientas/alertas.mjs",
    "hallazgos": "node herramientas/hallazgos.mjs",
    "semgrep": "uvx semgrep scan --config .semgrep/reglas-propias.yml src test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@firecrawl/pdf-inspector-wasm": "^1.17.0",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.21.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "wrangler": "^4.127.1",
    "yaml": "^2.9.0"
  }
}
