{
  "name": "mcp-cmf-chile",
  "version": "0.1.0",
  "description": "MCP server para la Comisión para el Mercado Financiero de Chile (CMF): empresas en bolsa, EEFF, fondos mutuos, fondos de inversión, normativa, seguros, indicadores y bancos. Libre, gratuito y open-source.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mcp-cmf-chile": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "wrangler dev",
    "dev": "node --watch dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "verify": "tsx test/verify-endpoints.ts",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "deploy": "wrangler deploy",
    "ci": "npm run build && npm test && npx tsx test/verify-endpoints.ts",
    "verificar-desplegado": "npx tsx test/verify-proto.ts && npx tsx test/verify-remote.ts",
    "preparar-hooks": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@firecrawl/pdf-inspector-wasm": "^0.1.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
