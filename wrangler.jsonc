{
  "name": "mcp-cmf-chile",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // El dominio propio va como ruta con custom_domain, que es la forma
  // que wrangler entiende. Antes esto decia "custom_domains", un campo
  // que NO existe, asi que wrangler lo descartaba con una advertencia y
  // el dominio funcionaba solo porque estaba puesto a mano en el panel.
  // Un archivo de configuracion que declara algo inerte es peor que uno
  // que no lo declara, porque nadie vuelve a mirarlo.
  "routes": [
    { "pattern": "cmf-mcp.kumocloud.cl", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "CMF_RATE_LIMIT_MS": "1100",
    "CMF_CACHE_TTL_S": "900",
    "CMF_MAX_ROWS": "500",
    "CMF_UPSTREAM_TIMEOUT_MS": "12000",
    "CMF_ESPERA_CUPO_MS": "120000",
    // Sin senal de vida por este tiempo, una consulta con cupo se da por
    // muerta y su cupo vuelve. Tiene que ser mas largo que la detencion mas
    // larga que el reloj de Workers esconde, y el tope de CPU de una
    // peticion es de 30 segundos. El minimo que se acepta es 5000.
    "CMF_GRACIA_CUPO_MS": "45000",
    "CMF_REINTENTO_403_MS": "6000",
    // Salida chilena. www.cmfchile.cl rechaza las IP de salida de
    // Cloudflare, asi que tras un 403 o un 520 la consulta se repite por
    // este proxy propio (infra/salida-chilena). Necesita ademas el secreto
    // CMF_PROXY_TOKEN, que se pone con wrangler secret put. Para apagarla
    // basta borrar esta linea y desplegar.
    "CMF_PROXY_URL": "https://cmf-salida.kumocloud.cl/"
  },
  // Caja aislada donde corre el código que escribe el modelo, en la ruta
  // /codigo. Se carga un Worker nuevo por programa, con globalOutbound
  // null (sin salida a internet). Requiere acceso a Worker Loader en la
  // cuenta; sin el binding, /codigo responde 501 y /  sigue funcionando.
  "worker_loaders": [
    { "binding": "CAJA" }
  ],
  // Cuota por IP para la ruta /codigo, que es la unica que ejecuta
  // codigo. El servidor es libre y gratuito a proposito, asi que no
  // lleva clave; lo que si lleva es un techo que impide que una sola
  // IP use la cuenta como computo propio. 30 programas por minuto es
  // holgado para un agente trabajando y corto para un abuso.
  "ratelimits": [
    {
      "name": "CUOTA_CODIGO",
      "namespace_id": "2001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CMF_KV",
      "id": "4440aa404d7c4880b06f93fad597e99d"
    }
  ],
  "triggers": {
    "crons": []
  }
}
