{
  "name": "mcp-cmf-chile",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "custom_domains": [
    { "domain": "cmf-mcp.kumocloud.cl" }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "CMF_RATE_LIMIT_MS": "1100",
    "CMF_CACHE_TTL_S": "900",
    "CMF_MAX_ROWS": "500",
    "CMF_UPSTREAM_TIMEOUT_MS": "12000"
  },
  // Caja aislada donde corre el código que escribe el modelo, en la ruta
  // /codigo. Se carga un Worker nuevo por programa, con globalOutbound
  // null (sin salida a internet). Requiere acceso a Worker Loader en la
  // cuenta; sin el binding, /codigo responde 501 y /  sigue funcionando.
  "worker_loaders": [
    { "binding": "CAJA" }
  ],
  // Cuota por IP para la ruta /codigo, que es la unica que ejecuta
  // codigo. El servidor es libre y gratuito a proposito, asi que no
  // lleva clave; lo que si lleva es un techo que impide que una sola
  // IP use la cuenta como computo propio. 30 programas por minuto es
  // holgado para un agente trabajando y corto para un abuso.
  "ratelimits": [
    {
      "name": "CUOTA_CODIGO",
      "namespace_id": "2001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CMF_KV",
      "id": "4440aa404d7c4880b06f93fad597e99d"
    }
  ],
  "triggers": {
    "crons": []
  }
}
