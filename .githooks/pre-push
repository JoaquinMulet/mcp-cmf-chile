#!/bin/sh
# Puerta COMPLETA antes de empujar. Corre exactamente lo que corre el CI
# sobre el codigo local, incluida la verificacion exhaustiva contra la
# CMF real, que es la que atrapa los errores de esquema de salida.
#
# Tarda unos minutos y eso NO es un argumento para recortarlo. Un porton
# lento cuesta minutos; un defecto que se escapa cuesta un entregable
# equivocado. Los costos no son comparables, asi que la duracion no
# decide que se ejecuta. Si molesta, se hace mas rapido, no mas corto.
#
# Lo que NO corre aca son verify-proto y verify-remote, porque hablan con
# la instancia DESPLEGADA. Esos van despues de `npm run deploy`, con
# `npm run verificar-desplegado`.
set -e

echo "[pre-push] compilando..."
npm run build

echo "[pre-push] suite completa..."
npm test

echo "[pre-push] verificacion exhaustiva contra la CMF real..."
npx tsx test/verify-endpoints.ts

# El mismo comando que corre el flujo de Seguridad. Solo las dependencias
# que llegan al Worker desplegado. Sin este paso el porton local corria
# MENOS que la CI, y el 2 de septiembre de 2026 eso dejo 3 commits en rojo
# en el remoto sin que nadie local lo viera.
echo "[pre-push] vulnerabilidades conocidas en dependencias de produccion..."
npm audit --omit=dev --audit-level=high

echo "[pre-push] verde. Esto es lo mismo que va a correr el CI."

echo "[pre-push] trinquete de calidad..."
node herramientas/trinquete.mjs

# INFORMA, no bloquea, y la razon importa. las alertas reflejan el
# ULTIMO commit ya analizado, o sea una senal ATRASADA. Bloquear el push
# con ella impediria empujar justamente el commit que la arregla. El que
# BLOQUEA corre en la nube, despues del analisis del commit nuevo.
# Aca se imprimen para que dejen de vivir en una pagina que nadie abre.
echo "[pre-push] alertas de seguridad abiertas (informativo)..."
node herramientas/alertas.mjs --listar

# La bandeja de hallazgos. BLOQUEA si hay alguno sin triar.
#
# Cada hallazgo se arregla, se marca falso positivo o se acepta como
# deuda, y los 2 ultimos con su razon escrita. No hay cuarta opcion, y
# esa es toda la idea. un hallazgo que vive donde nadie mira no existe.
echo "[pre-push] bandeja de hallazgos..."
node herramientas/hallazgos.mjs
