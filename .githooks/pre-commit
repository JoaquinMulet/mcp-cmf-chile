#!/bin/sh
# Porton antes de cada commit. Corre TODO lo que se puede saber sin red
# ni despliegue.
#
# Por que no se recorta por tiempo. El 21 de agosto de 2026 este hook
# decia "unos 15 segundos, nada mas: un porton lento se termina
# saltando". El dueno lo corrigio: jamas limitar el trabajo por lo que
# tarda una prueba, es mejor correr todo y tener toda la informacion.
# Tiene razon, y la razon es que los costos no son comparables. un
# porton lento cuesta minutos; un defecto que se escapa cuesta un
# entregable equivocado y una ronda perdida con quien confia en el
# resultado.
#
# El criterio para repartir entre etapas no es la velocidad, es que
# informacion existe recien en esa etapa. Lo que necesita red va en
# pre-push. Lo que solo existe desplegado va despues de desplegar.
#
# Si algun dia esto molesta por lento, se hace mas rapido (cache,
# paralelismo, incremental). No se ejecuta menos.
set -e

echo "[pre-commit] compilando..."
npm run build

echo "[pre-commit] suite completa (incluye las comprobaciones de clase)..."
npm test

echo "[pre-commit] estilo, complejidad y declaraciones muertas..."
npx biome lint src test --max-diagnostics=1000 --reporter=summary || true
npx --yes knip --no-progress || true

echo "[pre-commit] verde."
echo ""
echo "Antes de escribir el mensaje, mira si algo quedo para limpiar."
echo "  - Codigo que dejo de usarse con este cambio."
echo "  - Numeros o textos repetidos en 2 lugares."
echo "  - Comentarios que describen como era antes."
echo "Regla del dueno. el sistema se entrega mas limpio de lo que estaba."
